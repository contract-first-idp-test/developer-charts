{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["systemName", "groupId", "apiName", "repository", "revision", "serviceAccountName", "schemaRegistry", "spectralRules"],
  "properties": {
    "systemName": {"type": "string", "minLength": 1},
    "groupId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "apiName": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "format": "uri"},
    "revision": {"type": "string", "minLength": 1},
    "serviceAccountName": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
    },
    "schemaRegistry": {
      "type": "object",
      "required": ["apiUrl"],
      "properties": {
        "apiUrl": {"type": "string", "format": "uri"}
      }
    },
    "spectralRules": {
      "type": "object",
      "required": ["repositoryUrl", "revision", "path"],
      "properties": {
        "repositoryUrl": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    }
  }
}
