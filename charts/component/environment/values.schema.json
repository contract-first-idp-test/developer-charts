{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["systemName", "componentName", "environment"],
  "properties": {
    "systemName": {"type": "string", "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"},
    "componentName": {"type": "string", "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"},
    "environment": {"type": "string", "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"}
  }
}
