{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["domainName", "systemName", "groupId", "systemRepository", "environment", "delivery", "environments", "registry", "schemaRegistry", "microcks", "spectralRules", "build"],
  "properties": {
    "domainName": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
    },
    "groupId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "systemRepository": {"type": "object", "required": ["url", "revision"]},
    "environment": {
      "type": "object",
      "required": ["name", "namespaceSuffix", "clusterDomain"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
        },
        "namespaceSuffix": {"type": "string"},
        "clusterDomain": {"type": "string", "minLength": 1}
      }
    },
    "delivery": {
      "type": "object",
      "required": ["namespace", "project", "destinationServer", "charts"],
      "properties": {
        "charts": {
          "type": "object",
          "required": ["repository", "revision"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "environments": {
      "type": "object",
      "required": ["order", "definitions"],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"}
        },
        "definitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["namespaceSuffix", "clusterDomain"],
            "properties": {
              "namespaceSuffix": {"type": "string"},
              "clusterDomain": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "required": ["host", "clusterId", "credentials"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "clusterId": {"type": "string", "minLength": 1},
        "credentials": {
          "type": "object",
          "required": ["sourcePullSecretName", "destinationPushSecretName", "runtimePullSecretName"],
          "properties": {
            "sourcePullSecretName": {"type": "string", "minLength": 1},
            "destinationPushSecretName": {"type": "string", "minLength": 1},
            "runtimePullSecretName": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "schemaRegistry": {
      "type": "object",
      "required": ["apiUrl", "authServerUrl"],
      "properties": {
        "apiUrl": {"type": "string", "format": "uri"},
        "uiUrl": {"type": "string", "format": "uri"},
        "authServerUrl": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "microcks": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "redirectUri": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "spectralRules": {
      "type": "object",
      "required": ["repositoryUrl", "revision", "path"],
      "properties": {
        "repositoryUrl": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "build": {
      "type": "object",
      "required": ["environment", "namespaceSuffix", "sourceRevision", "sccClusterRoleName"],
      "properties": {
        "environment": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
        }
      }
    }
  }
}
