{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["systemName", "resourceName", "clusterName", "postgresVersion", "instances", "storage", "user"],
  "properties": {
    "postgresVersion": {"type": "integer", "minimum": 13},
    "storage": {"type": "object", "required": ["size"]}
  }
}
